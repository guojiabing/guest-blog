---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, readingTime } from '../../data/posts';
import { path, formatDate } from '../../data/site';
export const getStaticPaths = (async () => (await getPosts()).map(post=>({params:{id:post.id},props:{post}}))) satisfies GetStaticPaths;
const { post } = Astro.props;
const { Content, headings } = await render(post);
const posts=await getPosts();const currentIndex=posts.findIndex(p=>p.id===post.id);const next=posts[(currentIndex+1)%posts.length];
---
<Layout title={post.data.title} description={post.data.description} article date={post.data.date}><div class="container article-shell" id="top"><a class="text-link article-back" href={path('blog/')}><span>←</span> 全部文章</a><header class="article-header"><div class="post-meta"><a class="category" href={path(`blog/?tag=${encodeURIComponent(post.data.category)}`)}>{post.data.category}</a><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>{!post.data.sourceUrl&&<span>约 {readingTime(post.body)} 分钟</span>}</div><h1>{post.data.title}</h1><p>{post.data.description}</p><div class="article-tags">{post.data.tags.map(tag=><a href={path(`blog/?tag=${encodeURIComponent(tag)}`)}># {tag}</a>)}</div></header><div class="article-layout"><article class="prose">{post.data.sourceUrl&&<aside class="source-notice"><span class="eyebrow">FROM THE ARCHIVE</span><p>这是一篇过往文章的索引，正文保留在博客园。</p><a href={post.data.sourceUrl} target="_blank" rel="noopener noreferrer">到博客园阅读完整文章 <Icon name="arrow" size={15}/></a></aside>}<Content/>{post.data.sourceUrl&&<p><a class="button-primary" href={post.data.sourceUrl} target="_blank" rel="noopener noreferrer">阅读原文 ↗</a></p>}</article><aside class="article-toc"><span class="eyebrow">ON THIS PAGE</span><p>文章目录</p><nav aria-label="文章目录">{headings.filter(h=>h.depth===2||h.depth===3).map(h=><a href={`#${h.slug}`} style={`padding-left:${h.depth===3?'14px':'0'}`}>{h.text}</a>)}</nav><div class="toc-note">记录，是为了<br/>更好地理解。</div></aside></div><div class="article-end"><p>感谢你读到这里。</p><div><button class="text-link" id="copy-link"><Icon name="copy" size={16}/><span>复制文章链接</span></button><a class="text-link" href={path('rss.xml')}><Icon name="rss" size={16}/> RSS 订阅</a></div><p id="copy-status" class="sr-only" aria-live="polite"></p></div>{next&&<a class="next-post" href={path(`blog/${next.id}/`)}><span class="eyebrow">继续阅读</span><h2>{next.data.title}</h2><Icon name="right"/></a>}</div></Layout>
<script>document.querySelector('#copy-link')?.addEventListener('click',async()=>{const label=document.querySelector('#copy-link span');const status=document.querySelector('#copy-status');try{await navigator.clipboard.writeText(location.href);if(label)label.textContent='链接已复制';if(status)status.textContent='文章链接已复制';}catch{if(label)label.textContent='请从地址栏复制链接';}});</script>
