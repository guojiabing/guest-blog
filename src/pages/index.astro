---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { path, projects } from '../data/site';
import { getPosts } from '../data/posts';
const posts = await getPosts();
const featured=posts.find(post=>post.data.featured) || posts[0];
---
<Layout>
  <div class="container" id="top">
    <section class="hero" aria-labelledby="hero-title"><div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> 你好，我是 Guest <span class="muted-divider">/</span> guojiabing</p><h1 id="hero-title">在代码里探索，<br/>在文字里<span class="hero-serif">生长。</span><span class="hero-spark">*</span></h1><p class="hero-description">把遇见的问题、做过的东西、偶尔闪过的想法，<br class="desktop-break"/>慢慢整理在这里。关于技术，也关于生活。</p><div class="hero-actions"><a href={path('blog/')} class="button-primary">开始阅读 <Icon name="right" size={17}/></a><a href={path('about/')} class="text-link">认识一下 <Icon name="arrow" size={16}/></a></div><div class="hero-topics"><span>最近关注</span><span>前端开发</span><span>开源工具</span><span>持续构建</span></div></div>
      <aside class="hero-note"><div class="note-top"><span><span class="status-dot small"></span> A LITTLE SPACE ON THE WEB</span><Icon name="code" size={17}/></div><div class="note-illustration" aria-hidden="true"><span class="orbit orbit-one"></span><span class="orbit orbit-two"></span><span class="orbit orbit-three"></span><span class="orbit-center">g<span>.</span></span><span class="orbit-star">✳</span><span class="orbit-dot"></span></div><div class="note-bottom"><p>保持好奇。<br/>让每一次探索，都有迹可循。</p><span class="mono">EST. 2026 ↗</span></div></aside>
    </section>
    <section class="writing-section" aria-labelledby="writing-title"><div class="section-head"><div><p class="eyebrow">THE NOTEBOOK <span>01</span></p><h2 id="writing-title">写下来，就有了回响<span>.</span></h2></div><a class="text-link" href={path('blog/')}>全部文章 <Icon name="arrow" size={16}/></a></div>
      <div class="writing-layout">{featured ? <a class="featured-post" href={path(`blog/${featured.id}/`)}><div class="featured-top"><span class="featured-label"><span class="status-dot small"></span> 新站手记</span><Icon name="arrow" size={22}/></div><div class="featured-art" aria-hidden="true"><span class="art-number">Aa</span><span class="art-line"></span><span class="art-caption">IDEAS GROW<br/>WHEN SHARED.</span></div><div class="featured-copy"><div class="post-meta"><span>2026.11.02</span><span>·</span><span>关于本站</span></div><h3>{featured.data.title}</h3><p>{featured.data.description}</p><span class="featured-more">读这篇记录 <Icon name="right" size={16}/></span></div></a> : <p class="empty-state">新的记录正在路上。</p>}<div class="recent-posts">{posts.filter(post=>post.id!==featured?.id).slice(0,3).map(post=><PostCard post={post}/>)}</div></div>
    </section>
    <section class="projects-section" aria-labelledby="projects-title"><div class="section-head"><div><p class="eyebrow">BUILT WITH CURIOSITY <span>02</span></p><h2 id="projects-title">想法，也可以运行<span>.</span></h2></div><a class="text-link" href={path('projects/')}>所有项目 <Icon name="arrow" size={16}/></a></div><div class="project-grid">{projects.slice(0,3).map(project=><ProjectCard project={project}/>)}</div><p class="section-footnote"><Icon name="github" size={14}/> 来自我的 GitHub · 一些小而具体的尝试</p></section>
    <section class="closing"><div><p class="eyebrow">STAY CONNECTED</p><h2>下一次灵感，<span>再见。</span></h2><p>没有推荐算法，只有新的记录。欢迎通过 RSS 保持连接。</p></div><a class="button-secondary" href={path('rss.xml')}><Icon name="rss" size={17}/> 订阅我的博客 <Icon name="arrow" size={17}/></a></section>
  </div>
</Layout>
