---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { site, path } from '../data/site';
import { getPosts } from '../data/posts';
interface Props { title?: string; description?: string; article?: boolean; date?: Date; }
const { title, description = site.description, article = false, date } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const posts = await getPosts();
const nav = [{label:'首页',url:''},{label:'文章',url:'blog/'},{label:'项目',url:'projects/'},{label:'归档',url:'archive/'},{label:'关于',url:'about/'}];
const current = Astro.url.pathname;
const image = new URL(path('og.svg'), Astro.site).href;
---
<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="description" content={description}/><meta name="author" content={site.name}/><meta name="color-scheme" content="dark light"/>
    <title>{fullTitle}</title><link rel="canonical" href={canonical}/><link rel="icon" href={path('favicon.svg')} type="image/svg+xml"/>
    <link rel="alternate" type="application/rss+xml" title={site.title} href={path('rss.xml')}/>
    <meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/><meta property="og:type" content={article ? 'article' : 'website'}/><meta property="og:url" content={canonical}/><meta property="og:image" content={image}/><meta property="og:locale" content="zh_CN"/>
    <meta name="twitter:card" content="summary"/><meta name="twitter:title" content={fullTitle}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={image}/>
    {date && <meta property="article:published_time" content={date.toISOString()}/>}
    <script is:inline>try { document.documentElement.dataset.theme = localStorage.getItem('guest-theme') || 'dark'; } catch {}</script>
    <script type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org', '@type':article ? 'BlogPosting' : 'WebSite', name:fullTitle, headline:fullTitle, description, url:canonical.href, inLanguage:'zh-CN', ...(date ? {datePublished:date.toISOString()} : {}), author:{'@type':'Person', name:site.name, url:site.github} })}/>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header"><div class="container header-inner">
      <a class="wordmark" href={path()} aria-label="Guest 首页"><span class="brand-mark">g<span>.</span></span><span>Guest<span class="wordmark-dot">.</span></span></a>
      <nav class="desktop-nav" aria-label="主导航">{nav.map(item => <a class:list={{active:current===path(item.url) || (item.url==='blog/' && current.startsWith(path('blog/')))}} href={path(item.url)} aria-current={current===path(item.url) ? 'page' : undefined}>{item.label}</a>)}</nav>
      <div class="header-actions"><button class="search-trigger" data-open-search aria-label="搜索文章"><Icon name="search" size={17}/><span>搜索</span><kbd>⌘ K</kbd></button><span class="header-divider"></span><button class="icon-button theme-toggle" aria-label="切换到浅色模式"><span class="sun-icon"><Icon name="sun" size={19}/></span><span class="moon-icon"><Icon name="moon" size={19}/></span></button><a class="icon-button github-header" href={site.github} target="_blank" rel="noopener noreferrer" aria-label="访问我的 GitHub"><Icon name="github" size={19}/></a><button class="icon-button menu-toggle" aria-label="打开导航" aria-expanded="false" aria-controls="mobile-nav"><Icon name="menu"/></button></div>
    </div><nav id="mobile-nav" class="mobile-nav container" aria-label="移动端导航" hidden>{nav.map(item => <a href={path(item.url)}>{item.label}</a>)}</nav></header>
    <main id="main"><slot/></main>
    <footer class="site-footer container"><div><a class="footer-brand" href={path()}>Guest<span>.</span></a><span class="footer-copy">© {new Date().getFullYear()} · 保持好奇，持续构建。</span></div><div class="footer-links"><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub <Icon name="arrow" size={13}/></a><a href={path('rss.xml')}><Icon name="rss" size={14}/> RSS</a><a href={path('colophon/')}>关于本站</a><a href="#top" class="back-top" aria-label="回到顶部">↑</a></div></footer>
    <dialog id="search-dialog" aria-labelledby="search-title"><div class="search-modal"><div class="search-input-row"><Icon name="search"/><label class="sr-only" for="global-search" id="search-title">搜索文章</label><input id="global-search" type="search" placeholder="搜索标题、标签或关键词…" autocomplete="off"/><button class="icon-button" id="close-search" aria-label="关闭搜索"><Icon name="close"/></button></div><div class="search-results">{posts.map(post => <a class="search-result" href={path(`blog/${post.id}/`)} data-search={`${post.data.title} ${post.data.category} ${post.data.description} ${post.data.tags.join(' ')}`}><span>{post.data.title}</span><small>{post.data.category} <Icon name="arrow" size={14}/></small></a>)}<p id="search-empty" class="empty-state" hidden>没有找到相关记录，换个关键词试试。</p></div><div class="search-hint"><span id="search-count" aria-live="polite">{posts.length} 篇记录</span><span><kbd>esc</kbd> 关闭 · <kbd>tab</kbd> 选择</span></div></div></dialog>
    <script>
      const themeButton = document.querySelector<HTMLButtonElement>('.theme-toggle');
      function updateThemeLabel() { themeButton?.setAttribute('aria-label', `切换到${document.documentElement.dataset.theme === 'dark' ? '浅' : '深'}色模式`); }
      updateThemeLabel();
      themeButton?.addEventListener('click', () => { const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'; document.documentElement.dataset.theme=theme; try {localStorage.setItem('guest-theme',theme);}catch{} updateThemeLabel(); });
      const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
      menu?.addEventListener('click', () => {const nav=document.querySelector<HTMLElement>('#mobile-nav'); if(!nav)return; nav.hidden=!nav.hidden; menu.setAttribute('aria-expanded',String(!nav.hidden));menu.setAttribute('aria-label',nav.hidden?'打开导航':'关闭导航');});
      const dialog=document.querySelector<HTMLDialogElement>('#search-dialog');
      const input=document.querySelector<HTMLInputElement>('#global-search');
      const items=[...document.querySelectorAll<HTMLElement>('.search-result')];
      function filterSearch() {const q=input?.value.trim().toLocaleLowerCase() || ''; let count=0; items.forEach(item=>{item.hidden=!(item.dataset.search || '').toLocaleLowerCase().includes(q);if(!item.hidden)count++;}); const empty=document.querySelector<HTMLElement>('#search-empty'); if(empty)empty.hidden=count>0; const countLabel=document.querySelector('#search-count');if(countLabel)countLabel.textContent=`${count} 篇记录`;}
      function openSearch(){if(!dialog?.open){dialog?.showModal();input?.focus();}}
      document.querySelectorAll('[data-open-search]').forEach(button=>button.addEventListener('click',openSearch));
      input?.addEventListener('input',filterSearch);
      document.querySelector('#close-search')?.addEventListener('click',()=>dialog?.close());
      dialog?.addEventListener('click',(event)=>{if(event.target===dialog)dialog.close();});
      document.addEventListener('keydown',(event)=>{const target=event.target as HTMLElement;if((event.metaKey||event.ctrlKey)&&event.key==='k'){event.preventDefault();openSearch();}else if(event.key==='/'&&!['INPUT','TEXTAREA'].includes(target.tagName)&&!target.isContentEditable){event.preventDefault();openSearch();}});
    </script>
  </body>
</html>
