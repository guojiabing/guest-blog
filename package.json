{
  "name": "guest-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "preview:cloudflare": "wrangler pages dev dist --ip 127.0.0.1 --port 8788",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler pages deploy dist --project-name jiabing-blog"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.14",
    "@astrojs/sitemap": "^3.6.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "astro": "^5.16.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "typescript": "^5.9.3",
    "wrangler": "^4.156.1"
  }
}
